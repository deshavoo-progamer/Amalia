# Public URL of the site, used for canonical links, sitemap, robots, Open Graph and auth callbacks.
NEXT_PUBLIC_SITE_URL=https://example.com

# PostgreSQL connection string (local Postgres, or Neon/Supabase in production).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/baby_amalia

# Random 32+ byte secret that signs session cookies, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET=

# Phone numbers (E.164, comma-separated) allowed into the admin dashboard.
ADMIN_PHONES=+9665XXXXXXXX
